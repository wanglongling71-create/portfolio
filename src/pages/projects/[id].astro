---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const project = id ? await getEntry('projects', id) : undefined;

if (!project) {
  return Astro.redirect(import.meta.env.BASE_URL + '/projects');
}

const { Content } = await render(project);
const { title, tags, links } = project.data;
---

<BaseLayout title={title}>
  <article class="section container">
    <!-- Back link -->
    <a href={import.meta.env.BASE_URL + '/projects'} class="back-link">&larr; 返回项目列表</a>

    <!-- Header -->
    <header class="project-header">
      <h1>{title}</h1>
      {
        tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )
      }
    </header>

    <!-- Links -->
    {
      links && (
        <div class="links">
          {links.paper && (
            <a href={links.paper} target="_blank" rel="noopener" class="link-btn">
              &#128196; 论文
            </a>
          )}
          {links.github && (
            <a href={links.github} target="_blank" rel="noopener" class="link-btn">
              &#9000; 源码
            </a>
          )}
          {links.demo && (
            <a href={links.demo} target="_blank" rel="noopener" class="link-btn">
              &#9654; 演示
            </a>
          )}
        </div>
      )
    }

    <!-- Markdown Content -->
    <div class="content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-text-light);
    margin-bottom: var(--space-8);
  }

  .back-link:hover {
    color: var(--color-primary-light);
  }

  .project-header {
    margin-bottom: var(--space-8);
  }

  .project-header h1 {
    margin-bottom: var(--space-4);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--color-primary-light);
    background-color: var(--color-primary-lighter);
    padding: var(--space-1) var(--space-3);
    border-radius: 9999px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }

  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color 0.2s, background-color 0.2s;
  }

  .link-btn:hover {
    border-color: var(--color-primary-light);
    background-color: var(--color-primary-lighter);
    color: var(--color-primary);
  }

  /* Prose styling for Markdown content */
  .content :global(h2) {
    font-size: var(--text-2xl);
    color: var(--color-primary);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .content :global(h3) {
    font-size: var(--text-lg);
    color: var(--color-primary);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .content :global(p) {
    margin-bottom: var(--space-4);
    line-height: var(--leading-relaxed);
    text-indent: 2em;
  }

  .content :global(ul),
  .content :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .content :global(li) {
    margin-bottom: var(--space-2);
    line-height: var(--leading-relaxed);
  }

  .content :global(strong) {
    color: var(--color-primary);
    font-weight: var(--font-semibold);
  }

  .content :global(code) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background-color: var(--color-bg-alt);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  .content :global(blockquote) {
    border-left: 3px solid var(--color-primary-light);
    padding-left: var(--space-4);
    color: var(--color-text-light);
    font-style: italic;
    margin-bottom: var(--space-4);
  }
</style>
