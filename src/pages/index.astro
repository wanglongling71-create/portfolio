---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const projects = await getCollection('projects');
const featured = projects
  .filter((p) => p.data.featured)
  .sort(
    (a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0)
  );
---

<BaseLayout title="首页">
  <section class="hero">
    <div class="container hero-inner">
      <div class="profile">
        <img src={import.meta.env.BASE_URL + '/avater.jpg'} alt="汪珑玲头像" class="avatar" />
        <div class="identity">
          <p class="eyebrow">Academic Portfolio</p>
          <h1>{site.fullName}</h1>
          <p class="subtitle">{site.title}</p>
        </div>
      </div>
      <p class="tagline">{site.tagline}</p>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section container">
        <div class="section-heading">
          <h2>精选项目</h2>
          <a href={import.meta.env.BASE_URL + '/projects'}>全部项目</a>
        </div>
        <div class="project-grid">
          {featured.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              href={import.meta.env.BASE_URL + '/projects/' + project.id}
            />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-20) var(--space-16);
  }

  .hero-inner {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-12);
  }

  .profile {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    align-items: center;
    gap: var(--space-6);
  }

  .avatar {
    width: 6.5rem;
    height: 6.5rem;
    border-radius: 50%;
    object-fit: cover;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .hero h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-3);
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-primary-light);
  }

  .tagline {
    max-width: 42rem;
    margin-top: var(--space-8);
    font-size: var(--text-lg);
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-4);
  }

  h2 {
    font-size: var(--text-2xl);
  }

  .section-heading a {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-12);
    }

    .profile {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .hero h1 {
      font-size: var(--text-3xl);
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
