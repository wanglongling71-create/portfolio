---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineItem from '../components/TimelineItem.astro';
import site from '../data/site.json';
import { withBase } from '../lib/site-paths';
---

<BaseLayout title="关于我">
  <!-- Intro -->
  <section class="section container">
    <h1 class="page-title">关于我</h1>
    <div class="intro">
      <div class="intro-copy">
        <p>{site.intro}</p>
      </div>
      <figure class="intro-photo">
        <a
          href={withBase('/marathon.jpg')}
          target="_blank"
          rel="noopener"
          title="查看原图"
        >
          <img
            src={withBase('/marathon.jpg')}
            alt="汪珑玲参加马拉松比赛后的留影"
            width="1279"
            height="1704"
            loading="eager"
            decoding="async"
          />
        </a>
        <figcaption>马拉松完赛留影</figcaption>
      </figure>
    </div>
  </section>

  <!-- Education Timeline -->
  <section class="section-alt">
    <div class="container">
      <h2>教育经历</h2>
      <div class="timeline">
        {site.education.map((item) => (
          <TimelineItem
            degree={item.degree}
            school={item.school}
            period={item.period}
            details={item.details}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Internship Timeline -->
  <section class="section container">
    <h2>实习经历</h2>
    <div class="timeline">
      {site.experience.map((item) => (
        <TimelineItem
          degree={item.role}
          school={item.organization}
          period={item.period}
          details={item.details}
        />
      ))}
    </div>
  </section>

  <!-- Research Interests -->
  <section class="section-alt">
    <div class="container">
      <h2>研究方向</h2>
      <ul class="interests">
        {site.researchInterests.map((interest) => (
          <li>{interest}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Publications -->
  <section class="section container">
    <h2>论文发表</h2>
    {
      site.publications.length > 0 ? (
        <ol class="publications">
          {site.publications.map((pub) => (
            <li class="publication">
              <p class="pub-title">{pub.title}</p>
              <p class="pub-meta">
                {pub.authors} · {pub.journal} · {pub.year}
              </p>
              {pub.doi && (
                <a
                  href={`https://doi.org/${pub.doi}`}
                  target="_blank"
                  rel="noopener"
                >
                  DOI: {pub.doi}
                </a>
              )}
            </li>
          ))}
        </ol>
      ) : (
        <p class="pub-empty">论文成果整理中，将陆续更新。</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    align-items: start;
    gap: var(--space-8);
    max-width: 48rem;
    margin-inline: auto;
    text-align: left;
  }

  .intro p {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    text-indent: 2em;
  }

  .intro-photo {
    margin: 0;
  }

  .intro-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 38%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .intro-photo figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-light);
    text-align: center;
  }

  @media (max-width: 720px) {
    .intro {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .intro-photo {
      order: -1;
      justify-self: center;
      width: min(100%, 18rem);
    }
  }

  h2 {
    font-size: var(--text-2xl);
    color: var(--color-primary);
    margin-bottom: var(--space-8);
  }

  .timeline {
    max-width: 40rem;
  }

  .interests {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .interests li {
    font-size: var(--text-sm);
    color: var(--color-primary);
    background-color: var(--color-bg);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .publications {
    list-style: none;
    max-width: 40rem;
    display: grid;
    gap: var(--space-5);
  }

  .publication {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .pub-title {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .pub-meta {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    margin-bottom: var(--space-2);
  }

  .pub-empty {
    color: var(--color-text-light);
  }

  @media (max-width: 640px) {
    .interests {
      flex-direction: column;
    }
  }
</style>
